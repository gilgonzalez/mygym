# Mismo proyecto de Supabase que apps/web — usar la URL y la anon key
# públicas (nunca la service role key acá, esto corre en el dispositivo).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API de Next (apps/web) para firmar subidas a R2. En producción es
# https://mygymgigo.vercel.app. En un dispositivo físico, localhost no
# alcanza: usá la URL desplegada o la IP de tu máquina en la LAN.
EXPO_PUBLIC_API_URL=https://mygymgigo.vercel.app
